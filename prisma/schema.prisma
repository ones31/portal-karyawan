generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  KARYAWAN
}

enum JenisIzin {
  SAKIT
  LAINNYA
  SETENGAH_HARI
  TUGAS_NEGARA
  MENIKAH
}

enum StatusIzin {
  MENUNGGU
  DISETUJUI
  DITOLAK
}

// Status persetujuan akun. Akun buatan admin langsung AKTIF.
// Akun daftar mandiri (/daftar) mulai MENUNGGU sampai admin menyetujui;
// karyawan tetap bisa login & onboarding saat MENUNGGU (belum tampil di Daftar Karyawan utama).
// DITOLAK memblokir login.
enum StatusAkun {
  MENUNGGU
  AKTIF
  DITOLAK
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  password  String
  nama      String   @unique
  nip       String?  @unique // Nomor Induk Pegawai (nomor PIN mesin fingerprint), diisi admin
  phone     String?
  lokasi    String?  // "Tegal Alur" | "Menceng" — lokasi kerja (karyawan)
  lokasiAkses String? // "Tegal Alur" | "Menceng" — untuk role ADMIN: lokasi yang boleh dilihat/dikelola. null/SUPER_ADMIN = tanpa batasan.
  tanggalMasuk DateTime? // waktu mulai bekerja di toko
  // Status karyawan tetap yang DITETAPKAN MANUAL oleh owner (Feature 23).
  // Karyawan yang mulai kerja tahun 2026 ke atas tidak pernah otomatis jadi
  // tetap walau masa kerjanya lewat 3 tahun — kontraknya diperpanjang terus.
  // Hanya owner (SUPER_ADMIN) yang boleh mengubah field ini.
  tetapManual Boolean @default(false)
  role      Role     @default(KARYAWAN)
  statusAkun StatusAkun @default(AKTIF)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  profil     ProfilKaryawan?
  kontrak    Kontrak?
  izin       Izin[]
  tukarLibur TukarLibur[]
  pushSub    PushSubscription[]
  catatan       Catatan[] @relation("CatatanPenerima")
  catatanDibuat Catatan[] @relation("CatatanPengirim")
}

// Catatan/pesan khusus dari admin/owner ke karyawan (Feature 21).
// Tampil di beranda karyawan + kirim push notification saat dibuat.
// Kiriman ke banyak karyawan sekaligus disimpan sebagai satu baris PER karyawan
// (bukan satu baris broadcast) supaya status dibaca bisa dilacak per orang.
model Catatan {
  id         String    @id @default(cuid())
  userId     String    // karyawan penerima
  user       User      @relation("CatatanPenerima", fields: [userId], references: [id], onDelete: Cascade)
  batchId    String    // sama untuk semua penerima dari satu kali kirim (untuk mengelompokkan kiriman massal di daftar admin)
  judul      String
  isi        String
  pengirimId String?   // admin/owner pembuat; null kalau akunnya sudah dihapus
  pengirim   User?     @relation("CatatanPengirim", fields: [pengirimId], references: [id], onDelete: SetNull)
  dibacaPada DateTime? // diisi saat karyawan menekan "Tandai sudah dibaca"
  createdAt  DateTime  @default(now())

  @@index([userId, dibacaPada])
  @@index([batchId])
}

// Langganan push notification per perangkat/browser
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model ProfilKaryawan {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nik            String?
  tempatLahir    String?
  tanggalLahir   DateTime?
  jenisKelamin   String?
  agama          String?
  alamat         String?
  telepon        String?
  namaAyahIbu    String?
  merokok        String?   // "Merokok" | "Tidak Merokok"
  statusNikah    String?
  kontakDarurat  String?
  npwp           String?
  bpjs           String?
  rekeningBank   String?
  pendidikan     String?
  tandaTangan    String?   // tanda tangan persetujuan peraturan & perjanjian saat onboarding (data URL)
  tandaTanganPada DateTime?
  updatedAt      DateTime  @updatedAt
}

model Kontrak {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mulaiKontrak      DateTime
  akhirKontrak      DateTime
  isiKontrak        String
  tandaTangan       String?   // data URL gambar tanda tangan
  setujuTataTertib  Boolean   @default(false)
  ditandatanganiPada DateTime?
}

model Izin {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jenis        JenisIzin
  tanggalMulai DateTime
  tanggalAkhir DateTime
  alasan       String
  suratDokter  String?    // nama file surat dokter di folder uploads/surat-dokter
  status       StatusIzin @default(MENUNGGU)
  feedbackAdmin String?   // opsional, diisi admin/owner saat setujui/tolak — tampil ke karyawan
  createdAt    DateTime   @default(now())
}

model TukarLibur {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tanggalLibur     DateTime   // tanggal libur yang ditukar
  tukarDengan      String     // nama rekan yang diajak tukar libur
  tanggalPengganti DateTime?  // tanggal libur pengganti (opsional)
  keterangan       String?
  status           StatusIzin @default(MENUNGGU)
  feedbackAdmin    String?    // opsional, diisi admin/owner saat setujui/tolak — tampil ke karyawan
  createdAt        DateTime   @default(now())
}
